{
  "name": "dpdpa-sentinel",
  "private": true,
  "version": "1.0.0",
  "description": "DPDPA Sentinel — automated preliminary DPDPA 2023 / DPDP Rules 2025 compliance assessment platform",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "typecheck": "npm run typecheck --prefix frontend && npm run typecheck --prefix backend",
    "test": "npm test --prefix backend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "db:migrate": "npm run prisma:migrate --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test:engine": "npm run test:engine --prefix backend",
    "test:api": "npm run test:api --prefix backend",
    "verify": "npm run typecheck && npm test && npm run build",
    "db:local": "npm run db:local --prefix backend",
    "db:local:setup": "npm run db:local:setup --prefix backend",
    "dev:all": "node scripts/dev.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
