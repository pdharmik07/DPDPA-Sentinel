# ---------------------------------------------------------------------------
# DPDPA Sentinel — backend environment
# Copy to .env and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Prisma).
# connect_timeout/pool_timeout keep requests failing fast (503) when postgres is
# unreachable, instead of hanging on the connection pool.
DATABASE_URL=postgresql://dpdpa:dpdpa@localhost:5432/dpdpa_sentinel?schema=public&connect_timeout=5&pool_timeout=10

# Secret used to sign JWTs. Generate with: openssl rand -base64 48
# Must be at least 32 characters. The server refuses to start without it.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# HTTP
BACKEND_PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins (strict CORS allowlist).
# 5174 is included because Vite falls back to it when 5173 is already taken —
# otherwise the app loads but every API call fails CORS preflight.
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Python NLP service. If unreachable the backend degrades to the
# deterministic rule engine alone — scans still succeed.
NLP_SERVICE_URL=http://localhost:8000
NLP_TIMEOUT_MS=15000
NLP_ENABLED=true

# Uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_TMP_DIR=./uploads
REPORT_DIR=./reports

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Analysis worker concurrency
ANALYSIS_CONCURRENCY=2
