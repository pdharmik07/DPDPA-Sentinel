// DPDPA Sentinel — database schema.
//
// Design notes:
//  * Every scan-scoped row is reachable only through Scan.userId. The service
//    layer asserts ownership before any read/write, which is what prevents IDOR.
//  * Rule rows carry BOTH the legal citation and a sourceType, so the UI can
//    always distinguish a statutory requirement from a project-specific check.
//  * effectiveFrom/effectiveTo exist because the DPDP Rules 2025 commence in
//    three tranches (13 Nov 2025 / 13 Nov 2026 / 13 May 2027) — see docs/RULE_ENGINE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────────────────────

enum ScanStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

/// Pipeline stage, drives the 7-step progress UI.
enum ScanStage {
  UPLOADED
  EXTRACTING
  PREPROCESSING
  ANALYZING
  EVALUATING_RULES
  SCORING
  REPORTING
  DONE
}

enum RuleStatus {
  PASS
  PARTIAL
  FAIL
  NOT_APPLICABLE
}

enum WeightClass {
  MANDATORY
  CONDITIONAL
  RECOMMENDED
}

/// Where the obligation comes from. Enforced at the schema level so a
/// recommendation can never be rendered as a statutory requirement.
enum SourceType {
  ACT
  RULES_2025
  PROJECT_SPECIFIC
  BEST_PRACTICE
}

enum Applicability {
  ALWAYS
  CONDITIONAL
  REQUIRES_LIVE_SCAN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportType {
  PDF
  JSON
}

// ── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scans Scan[]

  @@map("users")
}

model Scan {
  id        String     @id @default(cuid())
  userId    String
  fileName  String // sanitised original name, for display only
  fileType  String
  fileSize  Int
  status    ScanStatus @default(QUEUED)
  stage     ScanStage  @default(UPLOADED)
  error     String?

  /// Extracted policy text. Needed to re-render evidence on report view.
  /// This is the one privacy-sensitive column — see docs/DATABASE.md.
  extractedText String? @db.Text

  pages          Int?
  words          Int?
  sentences      Int?
  paragraphs     Int?
  extractionRate Float?

  /// False when the NLP service was unreachable and the scan ran on the
  /// deterministic engine alone. Surfaced in the UI and in reports.
  nlpAvailable Boolean @default(false)

  ruleVersion  String?
  durationMs   Int?
  startedAt    DateTime?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  findings Finding[]
  reports  Report[]
  score    ScanScore?
  risk     RiskAssessment?

  @@index([userId, createdAt])
  @@map("scans")
}

model Rule {
  id String @id @default(cuid())

  /// Stable business key from the rule pack, e.g. "N1", "C4", "SDF2".
  ruleId   String @unique
  category String
  categoryLabel String
  title    String

  description String @db.Text
  requirement String @db.Text

  // ── Legal provenance ──────────────────────────────────────────────────
  sourceType        SourceType
  legalBasis        String?
  actSection        String?
  ruleReference     String?
  scheduleReference String?
  sourceUrl         String?

  // ── Versioning ────────────────────────────────────────────────────────
  ruleVersion   String
  legalVersion  String
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  /// Free-text note when a date could not be established from the sources.
  effectiveNote String?

  // ── Evaluation ────────────────────────────────────────────────────────
  weightClass   WeightClass
  weight        Float
  severity      Severity
  applicability Applicability

  /// Serialized detection payload: anchors, supporting, specifics,
  /// applicabilityTriggers, semanticConcepts, negativeIndicators.
  detection Json

  recommendation String  @db.Text
  remediation    String  @db.Text
  suggestedLanguage String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  findings Finding[]

  @@index([category])
  @@map("rules")
}

model Finding {
  id     String @id @default(cuid())
  scanId String
  ruleId String

  status RuleStatus

  applicable         Boolean @default(true)
  applicabilityReason String? @db.Text

  /// 0..1 — engine confidence that the clause is present and adequate.
  confidence Float @default(0)
  /// Fraction of the rule's points credited (1 / partial / 0).
  credit     Float @default(0)
  /// Points actually earned under the design-document scoring model.
  points     Float @default(0)
  maxPoints  Float @default(0)

  /// [{ sentence, index, paragraph, score, negated, hedged, semanticScore }]
  evidence Json @default("[]")

  matchedSpecifics String[] @default([])
  missingSpecifics String[] @default([])

  negationDetected Boolean @default(false)
  hedgingDetected  Boolean @default(false)
  /// True when the semantic layer contributed to confidence.
  semanticSupport  Boolean @default(false)

  reasoning      String   @db.Text
  recommendation String?  @db.Text
  remediation    String?  @db.Text
  legalReference String?
  severity       Severity
  priority       Priority?

  createdAt DateTime @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  rule Rule @relation(fields: [ruleId], references: [ruleId], onDelete: Restrict)

  @@unique([scanId, ruleId])
  @@index([scanId, status])
  @@map("findings")
}

model ScanScore {
  id     String @id @default(cuid())
  scanId String @unique

  /// 0..100, weighted average of category scores (design-document model).
  overallScore Float
  verdict      String
  /// Identifies the formula used, so historical scans stay interpretable.
  scoringModel String @default("design-doc-1.0")

  earnedPoints Float
  maxPoints    Float

  passedCount        Int @default(0)
  partialCount       Int @default(0)
  failedCount        Int @default(0)
  notApplicableCount Int @default(0)

  /// [{ id, label, score, earned, possible, rules, weightClass }]
  categoryScores Json @default("[]")

  createdAt DateTime @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@map("scan_scores")
}

model RiskAssessment {
  id     String @id @default(cuid())
  scanId String @unique

  level RiskLevel
  /// Human-readable explanation of why this level was assigned.
  explanation String @db.Text
  /// [{ code, label, detail, weight, triggered }] — the audit trail.
  factors Json @default("[]")

  criticalFindings Int @default(0)
  highFindings     Int @default(0)

  createdAt DateTime @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@map("risk_assessments")
}

model Report {
  id         String     @id @default(cuid())
  scanId     String
  reportType ReportType

  /// Server-side path, never exposed to the client. Downloads are streamed
  /// through an ownership-checked controller.
  filePath  String?
  fileSize  Int?
  checksum  String?

  generatedAt DateTime @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId, reportType])
  @@map("reports")
}
